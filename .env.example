# Lozinke za ulaz u aplikaciju (svaka mora biti različita)
# Admin: održavanje, vidi i mijenja oba kalendara
ADMIN_PASSWORD=
# Sanja: svoj kalendar + pregled Ninin
PASSWORD_SANJA=
# Nina: samo svoj kalendar
PASSWORD_NINA=
# Nasumičan tekst od najmanje 16 znakova (npr. `openssl rand -base64 32`)
SESSION_SECRET=

SALON_NAME=Crystal Beauty
# Ime pošiljaoca SMS-a, najviše 11 znakova
SMS_SENDER=Crystal

# iPhone: nasumičan tekst od najmanje 16 znakova; SMS tada šalje iPhone preko Prečica
IPHONE_TOKEN=

# Infobip – bez ovoga aplikacija radi u test načinu (SMS se samo upisuje u log)
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
